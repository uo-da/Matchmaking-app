# Frontend: optional explicit backend base URL (e.g. https://xxxx-5000.app.github.dev)
REACT_APP_API_BASE=

# Backend OAuth settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=

# Codespaces/local routing
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
GITHUB_SUCCESS_URL=http://localhost:3000
GITHUB_FAILURE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# CRA HMR websocket (0 = use browser port)
WDS_SOCKET_PORT=0
